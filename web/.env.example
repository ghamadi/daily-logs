# Supabase — from the Supabase project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=supabase-publishable-key

# Dev database — docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/main
# Test database — docker-compose.test.yml -- `getDatabaseUrl()` selects TEST_DATABASE_URL when NODE_ENV=test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5443/test_db

# Vercel AI Gateway
AI_GATEWAY_API_KEY=ai-gateway-api-key
