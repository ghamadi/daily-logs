{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@infrastructure/*": ["src/lib/infrastructure/*"],
      "@test/*": ["test/*"],
      // Resolution-only mappings: workspace deps export raw .ts source, so tsc
      // compiles their files under this tsconfig and must resolve their internal
      // aliases. Do not import via these aliases here — use @daily-logs/* deps.
      "@domains/*": ["../domains/src/*"],
      "@db/*": ["../db/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", ".next"]
}
