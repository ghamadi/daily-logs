{
  "name": "@daily-logs/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "root-scripts": "pnpm -C ..",
    "db:test:wait": "NODE_ENV=test tsx test/server/scripts/wait-for-db.ts",
    "db:test:prepare": "pnpm root-scripts db:test:up && pnpm db:test:wait && pnpm root-scripts db migrate:test",
    "db:test:reset": "pnpm root-scripts db:test:down && pnpm db:test:prepare",
    "test": "pnpm db:test:prepare && pnpm test:server",
    "test:server": "vitest run --config vitest.config.ts",
    "test:server:watch": "vitest --config vitest.config.ts",
    "test:e2e": "pnpm db:test:prepare && playwright test",
    "test:e2e:headed": "pnpm db:test:prepare && playwright test --headed"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.179",
    "@daily-logs/db": "workspace:*",
    "@daily-logs/domains": "workspace:*",
    "@daily-logs/utils": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.100.0",
    "@tanstack/react-query": "^5.100.9",
    "ai": "^6.0.177",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.15",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.4",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
